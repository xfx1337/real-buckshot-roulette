__pycache__/
*.pyc
.env
.venv/
venv/
env/
.pytest_cache/

# macOS
.DS_Store

# Локальный конфиг с реальными данными (Wi-Fi пароль и т.п.) — не в git.
# В репозитории только config.example.json как шаблон.
config.json
esp/config.h

# Референсы: декомпилированный Godot-проект игры и дизайн-макеты
# (большие бинарные ассеты, не часть веб-приложения)
/reference/

# Озвучка: пользовательские оверрайды и загруженные звуки (не часть репо)
sound_overrides.json
app/static/audio/custom/

# База данных busy каналов (локальные данные, не для git)
data/busy_channels.db
data/test_busy_channels.db

# Node deps (vendored JS + Playwright)
node_modules/
test-results/
playwright-report/

.claude/worktrees/

# MediaMTX: скачивается автоматически кнопкой «Запустить сервер» (~29 МБ бинарь)
mediamtx/

# Медиа: аудио и видео в репозитории не хранятся.
# Звуки игры, референсы голосов и мемы весят десятки-сотни мегабайт и
# раздаются отдельно, а не через git.
*.wav
*.mp3
*.ogg
*.flac
*.m4a
*.aac
*.opus
*.aiff
*.wma
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wmv
*.flv
*.m4v
*.mpg
*.mpeg

# Референсные семплы для клонирования голосов и сгенерированная озвучка.
voices/

# Мемы: аудио- и текстовые нарезки, локальный контент.
МЕМЫ/
text_memes/

# Веса моделей TTS и прочие большие бинарные артефакты.
*.pth
*.ckpt
*.safetensors

# Рантайм-состояние Asterisk: база astdb и сгенерированные тоны создаются
# при запуске АТС на конкретной машине, в репозитории им не место.
voip/var/

# Логи процессов, которые поднимает run-all.sh: пишутся на каждом запуске,
# содержимое зависит от машины.
logs/*.log
