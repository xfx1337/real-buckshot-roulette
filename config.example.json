{
  "server": {
    "host": "0.0.0.0",
    "port": 8000
  },
  "esp": {
    "wifi_ssid": "YOUR_WIFI_SSID",
    "wifi_password": "YOUR_WIFI_PASSWORD",
    "server_base_url": "http://192.168.1.100:8000",
    "pins": {
      "trigger": 4,
      "solenoid": 5,
      "live_led": 2
    },
    "trigger_remote": {
      "code": 0,
      "protocol": 1,
      "bitlength": 24
    }
  },
  "voip_esp": {
    "extension": "105",
    "dialer_token": ""
  },
  // Случайные звонки с мемами из папки МЕМЫ/ (только мультиплеер). В
  // произвольный момент партии, когда линия свободна, аппарат либо звонит сам
  // (тогда мем играет сразу по снятию трубки), либо на экране появляется
  // номер с просьбой позвонить (тогда три гудка, затем мем).
  "memes": {
    "enabled": true,
    // Границы паузы между звонками, секунды.
    "min_seconds": 240,
    "max_seconds": 600,
    // Доля входящих; остальное — просьба позвонить самому.
    "incoming_share": 0.6,
    // Сколько живёт выданный номер, секунды.
    "outgoing_seconds": 120,
    // Номера для исходящих мемов. Вне диапазона слотов оператора (510–529).
    "numbers": ["600", "601", "602", "603", "604",
                "605", "606", "607", "608", "609"],
    // Не повторять мем, пока не сыграли столько других. 0 — треть библиотеки.
    "no_repeat": 0,

    // Текстовые вставки на телевизоре, из text_memes/memes.json. Живут в том
    // же расписании, что и звонки, и никогда не идут одновременно с ними:
    // очередная вставка бывает либо звонком, либо текстом.
    "text_enabled": true,
    // Доля текстовых среди всех вставок; остальное — телефонные звонки.
    "text_share": 0.6,
    // Сколько текст висит после того, как допечатался, секунды.
    "text_hold": 5.0,
    // Миллисекунд на знак при печати.
    "text_speed": 45,
    // Поверх видео/камер (true) или на чёрном фоне (false).
    "text_over_video": true
  },
  // Прогон сценария без стола: off — боевой режим, hardware — тест со стойкой,
  // mock — тест без железа (телефон и курок изображаются). Переключается в
  // операторской: ⚙ → ТЕСТОВЫЙ РЕЖИМ.
  "test_mode": "off"
}
